<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen 图标背景层：深紫径向渐变 + 唱片中心透出的暖光。
     背景层跟随 launcher 视差，渐变范围比可见区域更大，避免边缘露色。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="82"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#4B2A80" />
                <item android:offset="0.55" android:color="#2A1652" />
                <item android:offset="1" android:color="#0B0616" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#99FFB45C" />
                <item android:offset="0.45" android:color="#3DFFB45C" />
                <item android:offset="1" android:color="#00FFB45C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
